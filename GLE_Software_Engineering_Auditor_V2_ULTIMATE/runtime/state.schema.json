{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRunState",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "enum": [
        "INIT",
        "DISCOVER",
        "REQUIREMENTS",
        "RESEARCH",
        "CODEBASE_STATE",
        "ARCHITECT",
        "PLAN",
        "CONSISTENCY_GATE",
        "IMPLEMENT",
        "VERIFY",
        "SECURITY_AUDIT",
        "FINAL_AUDIT",
        "DEBRIEF",
        "HANDOFF",
        "COMPLETE",
        "STOP_AND_REQUEST_USER"
      ]
    },
    "reason": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    }
  }
}