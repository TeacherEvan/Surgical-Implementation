{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentEvent",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "timestamp",
    "event",
    "state"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "INIT",
        "DISCOVER",
        "REQUIREMENTS",
        "RESEARCH",
        "CODEBASE_STATE",
        "ARCHITECT",
        "PLAN",
        "CONSISTENCY_GATE",
        "IMPLEMENT",
        "VERIFY",
        "SECURITY_AUDIT",
        "FINAL_AUDIT",
        "DEBRIEF",
        "HANDOFF",
        "COMPLETE",
        "STOP_AND_REQUEST_USER"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "gen_ai.agent.name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
