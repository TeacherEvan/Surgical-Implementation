{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMissionEnvelope",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "mission_id",
    "role",
    "read_paths",
    "allowed_paths",
    "principles",
    "max_tool_calls",
    "return_schema"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "Investigator",
        "Researcher",
        "Architect",
        "Planner",
        "Reviewer",
        "Implementer",
        "Verifier",
        "Security Auditor",
        "Final Auditor",
        "Debriefer"
      ]
    },
    "read_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "const": "<RUN_WORKSPACE>/**"
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "return_schema": {
      "type": "object",
      "required": [
        "$schema",
        "type",
        "required",
        "properties"
      ]
    }
  }
}
